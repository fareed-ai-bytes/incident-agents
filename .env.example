# Copy to .env and adjust. Every endpoint must stay on localhost (rules.md).
MODEL_PROVIDER=ollama          # ollama | heuristic (offline, deterministic; for demos and CI)
MODEL_NAME=qwen2.5:7b-instruct # placeholder until the S3 benchmark picks a model
OLLAMA_BASE_URL=http://localhost:11434
CHECKPOINT_DB=var/checkpoints.sqlite
AUDIT_DB=var/audit.sqlite
WAREHOUSE_DB=var/warehouse.duckdb
MAX_ITERATIONS=6
CONFIDENCE_THRESHOLD=0.6
LOG_PAGE_SIZE=200
APPROVAL_TTL_HOURS=24
LOG_LEVEL=INFO
